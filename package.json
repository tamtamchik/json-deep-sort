{
  "name": "@tamtamchik/json-deep-sort",
  "version": "1.5.1",
  "description": "A comprehensive utility for sorting JSON objects by keys.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "author": "Yuri Tkachenko <yuri.tam.tkachenko@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tamtamchik/json-deep-sort#readme",
  "bugs": {
    "url": "https://github.com/tamtamchik/json-deep-sort/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tamtamchik/json-deep-sort.git"
  },
  "keywords": [
    "json",
    "sort",
    "json-sort",
    "keysort",
    "json-keysort",
    "json-deep-sort",
    "sorting",
    "typescript",
    "async-sort",
    "synchronous-sort",
    "json-manipulation",
    "data-processing",
    "json-utility",
    "json-tools"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch src",
    "prepublishOnly": "npm run check && npm run typecheck && npm run build && npm test && npm run test:package",
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=lcov node --import tsx --test test/*.test.ts",
    "test:package": "node test/package.test.mjs"
  },
  "files": [
    "dist"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || ^26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  }
}
